<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/catwallpaper"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="139dp"
        android:layout_height="169dp"
        app:srcCompat="@drawable/conf" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="41dp"
        android:layout_marginBottom="8dp"
        android:text="¡Registro Exitoso!"
        android:textColor="#333333"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="Tu cuenta de cuidador ha sido creada correctamente en la base de datos."
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="30sp" />

    <Button
        android:id="@+id/btnIrMenu"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#2196F3"
        android:text="Ir al Menú Principal"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>